{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/blog-archive",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/note-archive",
      "destination": "/note/",
      "permanent": true
    },
    {
      "source": "/blog-archive/web3",
      "destination": "/note/tag/web3/",
      "permanent": true
    },
    {
      "source": "/blog/tag/web3",
      "destination": "/note/tag/web3/",
      "permanent": true
    },
    {
      "source": "/blog/erc7962",
      "destination": "/note/erc7962/",
      "permanent": true
    },
    {
      "source": "/blog/dapp%E6%9E%B6%E6%9E%84",
      "destination": "/note/dapp%E6%9E%B6%E6%9E%84/",
      "permanent": true
    },
    {
      "source": "/blog/moss%E9%A1%B9%E7%9B%AE%E5%88%86%E6%9E%90",
      "destination": "/note/moss%E9%A1%B9%E7%9B%AE%E5%88%86%E6%9E%90/",
      "permanent": true
    },
    {
      "source": "/blog-archive/bb88",
      "destination": "/blog/tag/bb88/",
      "permanent": true
    },
    {
      "source": "/note-archive/defi-berkeley",
      "destination": "/note/tag/defi/",
      "permanent": true
    },
    {
      "source": "/note-archive/thoughts",
      "destination": "/note/tag/thoughts/",
      "permanent": true
    },
    {
      "source": "/blog/transformer-circuits-framework",
      "destination": "/note/transformer-circuits-framework/",
      "permanent": true
    }
  ]
}
